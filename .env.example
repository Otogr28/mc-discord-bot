# Copia este archivo a .env y rellena los valores.
# En el VPS estos valores van en /etc/mcserver/discord-bot.env (ver README).

# --- Discord ---
# Token del bot (Discord Developer Portal -> tu app -> Bot -> Reset Token).
DISCORD_TOKEN=

# ID del servidor (guild) de Discord. Opcional pero MUY recomendado:
# hace que los slash commands aparezcan al instante (sin él tardan ~1h).
# Activa el Modo Desarrollador en Discord, click derecho al server -> Copiar ID.
DISCORD_GUILD_ID=

# --- Crafty Controller ---
# En el VPS apunta al panel local. Cert autofirmado (no se verifica TLS).
CRAFTY_PANEL=https://127.0.0.1:8443
# API key de Crafty (la misma que usan los helpers: deploy-helpers).
CRAFTY_TOKEN=
# UUID del server en Crafty.
CRAFTY_SERVER_ID=19aa7f07-e3bd-481d-b029-1f3f6eac5f28

# --- Presentación ---
MC_SERVER_NAME=Realm Gates
MC_SERVER_ADDRESS=5.161.52.222
STATUS_REFRESH_SECONDS=60

# --- Sync de canales (vault de Obsidian -> Discord) ---
# Carpeta con los .md que describen cada canal (def. Channels).
CHANNELS_DIR=Channels
# JSON sidecar con el mapping archivo->canal/mensajes (generado en runtime).
# Excluido del rsync para que --delete no lo borre en el VPS.
SYNC_STATE_FILE=.sync-state.json
